{
    "name": "Development container",
    "image": "ghcr.io/thoughtpolice/a/devcontainer:canon",
    "containerUser": "vscode",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "overrideCommand": true,
    "updateContentCommand": [
        "/bin/bash",
        ".devcontainer/update-content.sh"
    ],
    "postCreateCommand": [
        "/bin/bash",
        ".devcontainer/post-create.sh"
    ],
    "waitFor": "postCreateCommand",
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "aseipp.depot-buck2",
                "rust-lang.rust-analyzer",
                "ms-azuretools.vscode-docker",
                "GitHub.vscode-github-actions"
            ],
            "settings": {
                "rust-analyzer.server.path": "/opt/devcontainer/profile/bin/rust-analyzer"
            }
        }
    },
    "remoteEnv": {
        "PATH": "${containerWorkspaceFolder}/buck/bin:${containerWorkspaceFolder}/buck/bin/extra:${containerEnv:PATH}"
    }
}
