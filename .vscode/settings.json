{
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,

    "files.associations": {
        ".buckconfig": "ini",
        ".buckconfig.local": "ini",
        "*.buckconfig": "ini",
    },

    "files.exclude": {
        "**/.direnv": true,
        "**/.jj": true,
    },

    "rust-analyzer.workspace.discoverConfig": {
        "command": [
            "rust-project",
            "develop-json",
            "--sysroot-mode=rustc",
            "{arg}"
        ],
        "progressLabel": "rust-analyzer[buck2]",
        "filesToWatch": ["BUILD", "PACKAGE"]
    },

    "rust-analyzer.check.overrideCommand": [
        "rust-project",
        "check",
        "$saved_file",
    ],

    "remote.extensionKind": {
        "aseipp.depot-buck2": ["workspace"],
    },
    "deno.enable": true,

    // Puts buck/toolchains/lean/lsp/bin/lean ahead of the Nix shell's, so the
    // Lean server gets its imports from Buck instead of Lake.
    "lean4.envPathExtensions": ["buck/toolchains/lean/lsp/bin"]
}
