            /* now we can generate the number */
            /* XXX: should patch directly float number */
            /* musl implements C99 hexadecimal conversion, including full
               long-double range and rounding. Keep the binary extension. */
            if (b != 16) {
                d = (double)bn[1] * 4294967296.0 + (double)bn[0];
                d = ldexp(d, exp_val - frac_bits);
            }
            t = toup(ch);
            if (t == 'F') {
                ch = *p++;
                tok = TOK_CFLOAT;
                /* float : should handle overflow */
                tokc.f = b == 16 ? strtof(number_start, NULL) : (float)d;
            } else if (t == 'L') {
                ch = *p++;
#ifdef TCC_TARGET_PE
                tok = TOK_CDOUBLE;
                tokc.d = b == 16 ? strtod(number_start, NULL) : d;
#else
                tok = TOK_CLDOUBLE;
                tokc.ld = b == 16 ? strtold(number_start, NULL) : (long double)d;
#endif
            } else {
                tok = TOK_CDOUBLE;
                tokc.d = b == 16 ? strtod(number_start, NULL) : d;
            }
