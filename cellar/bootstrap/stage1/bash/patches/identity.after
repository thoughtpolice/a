  struct passwd *entry;

  /* Explicit identity for isolated bootstrap actions and terminal tests.
     Ordinary invocations retain the system account database behavior. */
  if (current_user.user_name == 0 && getenv ("CELLAR_BOOTSTRAP_IDENTITY") &&
      current_user.uid == current_user.euid && current_user.gid == current_user.egid)
    {
      current_user.user_name = savestring ("bootstrap");
      current_user.shell = savestring ("/bin/bash");
      current_user.home_dir = savestring ("/");
      return;
    }

  /* Don't fetch this more than once. */
