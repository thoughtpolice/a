LIB_FLAGS = {
    "mgetgroups": [
        "-include",
        "stdlib.h",
    ],
    "openat-proc": [
        "-include",
        "unistd.h",
    ],
}

INCLUDES = [
    "lib",
    "src",
]

[c_object(
    name = "lib-" + name + ".o",
    src = ":source[lib/" + name + ".c]",
    defines = ["HAVE_CONFIG_H=1"],
    flags = [
        "-O2",
        "-Werror=implicit-function-declaration",
    ] + LIB_FLAGS.get(name, []),
    logical_includes = INCLUDES,
    logical_source = "lib/" + name + ".c",
    object_name = "cl" + str(i) + ".o",
    source_alias = "cellar//bootstrap/stage1/tools:source-alias",
    source_tree = ":source",
    toolchain = CC,
) for i, name in enumerate(LIB_SOURCES)]

c_library(
    name = "libcoreutils.a",
    objects = [":lib-" + name + ".o" for name in LIB_SOURCES],
    output = "libcoreutils.a",
    toolchain = CC,
)

[c_object(
    name = "src-" + name + ".o",
    src = ":source[src/" + ("md5sum" if name.startswith("sha") and name.endswith("sum") else name) + ".c]",
    defines = ["HAVE_CONFIG_H=1"] + (["HASH_ALGO_" + name[:-3].upper() + "=1"] if name in [
        "md5sum",
        "sha1sum",
        "sha224sum",
        "sha256sum",
        "sha384sum",
        "sha512sum",
    ] else []),
    flags = [
        "-O2",
        "-Werror=implicit-function-declaration",
    ],
    logical_includes = INCLUDES,
    logical_source = "src/" + ("md5sum" if name.startswith("sha") and name.endswith("sum") else name) + ".c",
    object_name = "cs" + str(i) + ".o",
    source_alias = "cellar//bootstrap/stage1/tools:source-alias",
    source_tree = ":source",
    toolchain = CC,
) for i, name in enumerate(PROGRAM_SOURCES)]

[c_binary(
    name = name,
    end_objects = CRTN,
    libraries = [":libcoreutils.a"] + LIBC,
    objects = CRT + [":src-" + source + ".o" for source in sources],
    output = "[" if name == "lbracket" else name,
    toolchain = CC,
) for name, sources in PROGRAMS.items()]

filegroup(
    name = "installation",
    srcs = {"bin/" + ("[" if name == "lbracket" else name): ":" + name for name in PROGRAMS} | {
        "share/licenses/coreutils/COPYING": ":source[COPYING]",
        "bin/groups": ":groups-script",
    },
)

[command_test(
    name = name + "-version",
    args = ["--version"],
    tool = ":" + name,
) for name in PROGRAMS if name not in [
    "false",
    "test",
]]

# Upstream shell program; install gives the generated artifact executable mode.
generate(
    name = "groups-text",
    args = [
        "-e",
        "s!@bindir@!/bootstrap/bin!g",
        "-e",
        "s/@PACKAGE_NAME@/GNU coreutils/g",
        "-e",
        "s/@PACKAGE_BUGREPORT@/bug-coreutils@gnu.org/g",
        "-e",
        "s/@VERSION@/6.10/g",
        "-e",
        "s/@RELEASE_YEAR@/2008/g",
        "$(location :coreutils-6.10[src/groups.sh])",
    ],
    capture = "cellar//bootstrap/stage1/tools:capture",
    tool = "cellar//bootstrap/stage1/sed:sed",
)

generate(
    name = "groups-script",
    args = [
        "-m",
        "755",
        "$(location :groups-text)",
    ],
    tool = ":install",
)

configured_tool(
    name = "groups",
    args = [
        "--noprofile",
        "--norc",
        "$(location :groups-script)",
    ],
    env = {
        "PATH": "$(location :installation[bin])",
        "CELLAR_BOOTSTRAP_IDENTITY": "1",
    },
    env_tool = "cellar//bootstrap/stage1/tools:withenv",
    tool = "cellar//bootstrap/stage1/bash:bash",
)

