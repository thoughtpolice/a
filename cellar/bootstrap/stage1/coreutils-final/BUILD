) for name, (template, values) in HEADER_CONFIG.items()]

# cksum.c embeds its own handwritten CRC generator above a release table.
# Strip the table before either generator or utility compilation.
generate(
    name = "cksum-stripped.c",
    args = [
        r'/^static uint_fast32_t const crctab\[256\] =/,/^};/c\#include "crctab.h"',
        "$(location :coreutils-6.10[src/cksum.c])",
    ],
    capture = "cellar//bootstrap/stage1/tools:capture",
    tool = "cellar//bootstrap/stage1/sed:sed",
)

c_object(
    name = "makecrctab.o",
    src = ":crc-source[src/cksum.c]",
    defines = [
        "CRCTAB=1",
        "HAVE_CONFIG_H=1",
    ],
    flags = [
        "-O2",
        "-Werror",
    ],
    logical_includes = INCLUDES,
