untar(
    name = "coreutils-6.10",
    chdirenv = "cellar//bootstrap/stage0-posix/cellar-extra:chdirenv",
    files = FILES + ["src/" + name for name in [
        "dircolors.h",
        "wheel.h",
        "fs.h",
    ]],
    flags = [
        "--numeric-owner",
        "-xf",
    ],
    input = "cellar//bootstrap/stage1/coreutils:coreutils.tar",
    untar = "cellar//bootstrap/stage1/tar:tar",
)

[
    [
        c_object(
            name = name + ".o",
            src = "generators/" + name + ".c",
            defines = ["_GNU_SOURCE=1"],
            flags = [
                "-O2",
                "-Wall",
                "-Wextra",
                "-Werror",
            ],
            object_name = name + ".o",
            toolchain = CC,
        ),
        c_binary(
            name = name,
            end_objects = CRTN,
            libraries = LIBC,
            objects = CRT + [":" + name + ".o"],
            toolchain = CC,
        ),
    ]
    for name in [
        "dcgen",
        "wheel-gen",
        "extract-magic",
    ]
]

generate(
    name = "dircolors.h",
    args = ["$(location :coreutils-6.10[src/dircolors.hin])"],
    capture = "cellar//bootstrap/stage1/tools:capture",
    tool = ":dcgen",
)

generate(
    name = "wheel.h",
    args = ["5"],
    capture = "cellar//bootstrap/stage1/tools:capture",
    tool = ":wheel-gen",
)

write_file(
    name = "wheel-size.h",
    content = "#define WHEEL_SIZE 5\n",
)

generate(
    name = "fs.h",
    args = ["$(location :coreutils-6.10[src/stat.c])"],
    capture = "cellar//bootstrap/stage1/tools:capture",
    tool = ":extract-magic",
)

filegroup(
    name = "generated",
    srcs = {name: ":" + name for name in [
        "dircolors.h",
        "wheel.h",
        "wheel-size.h",
        "fs.h",
    ]},
)

# These release-generated files are test fixtures, never compiler inputs.
filegroup(
    name = "reference-headers",
    srcs = {"src/" + name: ":coreutils-6.10[src/" + name + "]" for name in [
        "dircolors.h",
        "wheel.h",
        "fs.h",
    ]},
)

[command_test(
    name = name + "-reference",
    args = [
        "$(location :" + name + ")",
        "$(location :reference-headers[src/" + name + "])",
    ],
    tool = "cellar//bootstrap/stage0-posix/cellar-extra:bytecmp",
) for name in [
    "dircolors.h",
    "wheel.h",
    "fs.h",
]]

write_file(
    name = "malformed-magic.c",
    content = "  case S_MAGIC_INVALID: /* missing hex value */\n",
)

command_test(
    name = "reject-malformed-magic",
    args = [
        "1",
        "$(exe :extract-magic)",
        "$(location :malformed-magic.c)",
    ],
    tool = "cellar//bootstrap/stage1/tools:expect-exit",
)

command_test(
    name = "reject-invalid-wheel-size",
    args = [
        "1",
        "$(exe :wheel-gen)",
        "0",
    ],
    tool = "cellar//bootstrap/stage1/tools:expect-exit",
)

# Reviewed Linux AMD64/musl feature map. ACL/SELinux and message catalogs are
# optional external libraries; use the upstream disabled-feature code paths.
CONFIG_ON = [
    "D_INO_IN_DIRENT",
    "GNULIB_CANONICALIZE",
    "GNULIB_CLOSE_STREAM",
    "GNULIB_FCNTL_SAFER",
    "GNULIB_FOPEN_SAFER",
    "GNULIB_FTS",
    "HAVE_ALARM",
    "HAVE_ALLOCA",
    "HAVE_ALLOCA_H",
    "HAVE_ARPA_INET_H",
    "HAVE_ATEXIT",
    "HAVE_BTOWC",
    "HAVE_C99_STRTOLD",
    "HAVE_CALLOC",
    "HAVE_CALLOC_POSIX",
