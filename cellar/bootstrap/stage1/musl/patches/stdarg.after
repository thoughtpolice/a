#ifdef __TINYC__
void __va_start(struct __va_list_struct *, void *);
void *__va_arg(struct __va_list_struct *, int, int, int);
#define va_start(v,l) __va_start(v, __builtin_frame_address(0))
#define va_end(v) ((void)0)
#define va_arg(v,t) (*(t *)__va_arg(v, __builtin_va_arg_types(t), sizeof(t), __alignof__(t)))
#define va_copy(d,s) (*(d) = *(s))
#else
#define va_start(v,l)   __builtin_va_start(v,l)
#define va_end(v)       __builtin_va_end(v)
#define va_arg(v,l)     __builtin_va_arg(v,l)
#define va_copy(d,s)    __builtin_va_copy(d,s)
#endif