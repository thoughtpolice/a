# Fixed, independent checksums of the nine ASCII bytes '123456789'. MD5/SHA
# values come from Python hashlib, CRC32 from zlib; CRC32C and CRC64/NVME are
# the standard 'check' vectors (https://reveng.sourceforge.io/crc-catalogue/).
# S3 uses base64 of digest bytes, with CRC values in big-endian byte order.
# These expectations deliberately do not use chaos3/s3s checksum helpers.

PUT /{bucket}/checksum
  header Content-MD5: JfnnlDI7RTiF9RgfG2JNCw==
  header x-amz-checksum-crc32: y/Q5Jg==
  header x-amz-checksum-crc32c: 4waSgw==
  header x-amz-checksum-crc64nvme: rosUhgp5mIg=
  header x-amz-checksum-sha1: 98O8HYCOBHMq32eZZczDTKeuNEE=
  header x-amz-checksum-sha256: FeKw08M4keuw8e9gnsQZQgwg4yDOlMZfvIwzEkSOsiU=
  header x-amz-checksum-sha512: 2eZ2LdHI6vbWGzxhkvxAjU1tXxF20MKRabwk5xw/J0rSf81YEbMT1oH35V7ALXPUmclUVba1u1A6z1dPuo/+hQ==
  header x-amz-checksum-md5: JfnnlDI7RTiF9RgfG2JNCw==
  body 123456789
expect 200
  header ETag: "25f9e794323b453885f5181f1b624d0b"

GET /{bucket}/checksum
expect 200
  body-sha256 15e2b0d3c33891ebb0f1ef609ec419420c20e320ce94c65fbc8c3312448eb225
  body 123456789

# Each digest independently gates publication. The digest headers are valid
# base64, but deliberately describe bytes other than the supplied body.
PUT /{bucket}/bad-md5
  header Content-MD5: JfnnlDI7RTiF9RgfG2JNCw==
  body wrong
expect 400
  xml Code = BadDigest

HEAD /{bucket}/bad-md5
expect 404

PUT /{bucket}/checksum
  header x-amz-checksum-crc32: y/Q5Jg==
  body wrong
expect 400
  xml Code = BadDigest

PUT /{bucket}/checksum
  header x-amz-checksum-crc32c: 4waSgw==
  body wrong
expect 400
  xml Code = BadDigest

PUT /{bucket}/checksum
  header x-amz-checksum-crc64nvme: rosUhgp5mIg=
  body wrong
expect 400
  xml Code = BadDigest

PUT /{bucket}/checksum
  header x-amz-checksum-sha1: 98O8HYCOBHMq32eZZczDTKeuNEE=
  body wrong
expect 400
  xml Code = BadDigest

PUT /{bucket}/checksum
  header x-amz-checksum-sha256: FeKw08M4keuw8e9gnsQZQgwg4yDOlMZfvIwzEkSOsiU=
  body wrong
expect 400
  xml Code = BadDigest

PUT /{bucket}/checksum
  header x-amz-checksum-sha512: 2eZ2LdHI6vbWGzxhkvxAjU1tXxF20MKRabwk5xw/J0rSf81YEbMT1oH35V7ALXPUmclUVba1u1A6z1dPuo/+hQ==
  body wrong
expect 400
  xml Code = BadDigest

GET /{bucket}/checksum
expect 200
  header ETag: "25f9e794323b453885f5181f1b624d0b"
  body 123456789

# A rejected replacement must not evict a previously accepted multipart part.
POST /{bucket}/multipart?uploads
expect 200
  capture upload = xml UploadId

PUT /{bucket}/multipart?uploadId={upload}&partNumber=1
  header Content-MD5: JfnnlDI7RTiF9RgfG2JNCw==
  body 123456789
expect 200
  header ETag: "25f9e794323b453885f5181f1b624d0b"
  capture part = header ETag

PUT /{bucket}/multipart?uploadId={upload}&partNumber=1
  header x-amz-checksum-sha256: FeKw08M4keuw8e9gnsQZQgwg4yDOlMZfvIwzEkSOsiU=
  body invalid replacement
expect 400
  xml Code = BadDigest

POST /{bucket}/multipart?uploadId={upload}
  body <CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>{part}</ETag></Part></CompleteMultipartUpload>
expect 200
  xml ETag = "5927c5d64d94a5786f90003aa26d0159-1"

GET /{bucket}/multipart
expect 200
  body 123456789
