        }
      }
    },
    {
      "name": "a path that is not valid percent-encoding is a 400, not a crash",
      "request": {
        "path": "/ip/%E0"
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "the path is not valid percent-encoding"
        }
      }
    }
  ]
}
