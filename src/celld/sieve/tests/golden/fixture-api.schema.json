{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Event": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "finding"
            },
            "finding": {
              "$ref": "#/$defs/Finding"
            }
          },
          "required": [
            "type",
            "finding"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "done"
            },
            "sections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Section"
              }
            }
          },
          "required": [
            "type",
            "sections"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Finding": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "description": "What is wrong."
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "title",
        "severity",
        "at",
        "tags"
      ],
      "additionalProperties": false,
      "title": "Finding"
    },
    "Location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "Section": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        }
      },
      "required": [
        "heading",
        "findings",
        "sections"
      ],
      "additionalProperties": false
    },
    "Severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "How bad a finding is."
    }
  }
}
