{
  "vars": {
    "TOKEN_SECRET": "a2lj33x7e8v_7xtImJAmbf5VlaJqi25DklhPV4mjlrs"
  },
  "steps": [
    {
      "name": "a token request, normalized, for an hour",
      "request": {
        "method": "POST",
        "path": "/tokens",
        "json": {
          "owner": "Ada@Example.com",
          "name": " ci ",
          "scopes": [
            "read"
          ],
          "ttl": "PT1H"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "token": {
            "$regex": "^eyJ[\\w-]+\\.eyJ[\\w-]+\\.[\\w-]{43}$"
          },
          "scopes": [
            "read"
          ],
          "expires": {
            "$regex": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          }
        }
      },
      "save": {
        "reader": "json.token",
        "readerExpires": "json.expires"
      }
    },
    {
      "name": "the lifetime defaults to P7D",
      "request": {
        "method": "POST",
        "path": "/tokens",
        "json": {
          "owner": "bob@example.com",
          "name": "deploy",
          "scopes": [
            "read",
            "write"
          ]
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "scopes": [
            "read",
            "write"
          ]
        }
      },
      "save": {
        "writer": "json.token"
      }
    },
    {
      "name": "every problem with a request, at once",
      "request": {
        "method": "POST",
        "path": "/tokens",
        "json": {
          "owner": "nope",
          "name": "",
          "scopes": [
            "read",
            "sudo"
          ],
          "ttl": "P1M",
          "x": 1
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "$exact": {
            "formErrors": [
              "unrecognized key: \"x\""
            ],
            "fieldErrors": {
              "owner": [
                "invalid email address"
              ],
              "name": [
                "must have at least 1 character"
              ],
              "scopes": [
                "expected one of \"read\" | \"write\" | \"admin\""
              ],
              "ttl": [
                "must be a fixed length from 1 second to 90 days (P90D)"
              ]
            }
          }
        }
      }
    },
    {
      "name": "refinements: repeated scopes, and a lifetime past 90 days",
      "request": {
        "method": "POST",
        "path": "/tokens",
        "json": {
          "owner": "a@example.com",
          "name": "n",
          "scopes": [
            "read",
            "read"
          ],
          "ttl": "P13W"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "$exact": {
            "formErrors": [],
            "fieldErrors": {
              "scopes": [
                "scopes must not repeat"
              ],
              "ttl": [
                "must be a fixed length from 1 second to 90 days (P90D)"
              ]
            }
          }
        }
      }
    },
    {
      "name": "text that is not a duration",
      "request": {
        "method": "POST",
        "path": "/tokens",
        "json": {
          "owner": "a@example.com",
          "name": "n",
          "scopes": [
            "read"
          ],
          "ttl": "1h"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "fieldErrors": {
            "ttl": [
              "invalid ISO 8601 duration"
            ]
          }
        }
      }
    },
    {
      "name": "the token's claims come back parsed and typed",
      "request": {
        "method": "GET",
        "path": "/whoami",
        "headers": {
          "authorization": "Bearer {reader}"
        }
      },
      "expect": {
        "json": {
          "$exact": {
            "owner": "ada@example.com",
            "name": "ci",
            "scopes": [
              "read"
            ],
            "expires": "{readerExpires}"
          }
        }
      }
    },
    {
      "name": "a read-only token cannot write",
      "request": {
        "method": "POST",
        "path": "/notes",
        "headers": {
          "authorization": "Bearer {reader}"
        },
        "body": "remember the milk"
      },
      "expect": {
        "status": 403,
        "json": {
          "error": "needs the write scope"
        }
      }
    },
    {
      "name": "a token with write can",
      "request": {
        "method": "POST",
        "path": "/notes",
        "headers": {
          "authorization": "Bearer {writer}"
        },
        "body": "remember the milk"
      },
      "expect": {
        "status": 201,
        "json": {
          "saved": "remember the milk"
        }
      }
    },
    {
      "name": "no Authorization header: the schema's own message",
      "request": {
        "path": "/whoami"
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "missing Authorization"
        }
      }
    },
    {
      "name": "another scheme",
      "request": {
        "path": "/whoami",
        "headers": {
          "authorization": "Basic YWRhOnB3"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "expected Bearer <token>"
        }
      }
    },
    {
      "name": "a bearer that is not a JWT is refused before any cryptography",
      "request": {
        "method": "GET",
        "path": "/whoami",
        "headers": {
          "authorization": "Bearer abc.def"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "not an HS256 JWT"
        }
      }
    },
    {
      "name": "so is a JWT whose header names another algorithm",
      "request": {
        "method": "GET",
        "path": "/whoami",
        "headers": {
          "authorization": "Bearer eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZGFAZXhhbXBsZS5jb20iLCJuYW1lIjoieCIsInNjb3BlIjoicmVhZCIsImp0aSI6IjAxQVJaM05ERUtUU1Y0UlJGRlE2OUc1RkFWIiwiZXhwIjo0MTAyNDQ0ODAwfQ.C5f0wCtQr95Vo05Sauh1hIF_9I5XTCxg1vaSzdOfJMCUhbAubWdzQJo-aC7dCQt92P80jY3XO_aq0y_Vmm4fQw"
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "error": "not an HS256 JWT"
        }
      }
    },
    {
      "name": "a well-formed token can still fail verification",
      "request": {
        "method": "GET",
        "path": "/whoami",
        "headers": {
          "authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZGFAZXhhbXBsZS5jb20iLCJuYW1lIjoib2xkIiwic2NvcGUiOiJyZWFkIiwianRpIjoiMDFBUlozTkRFS1RTVjRSUkZGUTY5RzVGQVYiLCJleHAiOjE2MDAwMDAwMDB9.vNz-quGx2oPX011ZLplr0JVOXTD4djwPZkxKKiRp4WY"
        }
      },
      "expect": {
        "status": 401,
        "json": {
          "error": "expired"
        }
      }
    },
    {
      "name": "and a correctly signed token can still have claims this code does not accept",
      "request": {
        "method": "GET",
        "path": "/whoami",
        "headers": {
          "authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJhZGFAZXhhbXBsZS5jb20iLCJzY29wZSI6InJlYWQgc3VkbyIsImp0aSI6IjAxQVJaM05ERUtUU1Y0UlJGRlE2OUc1RkFWIiwiZXhwIjo0MTAyNDQ0ODAwfQ.iCWvt6yJbBVwF_v7eYrtH_Pm_Z1yq8I9Xgk11Xwm-o0"
        }
      },
      "expect": {
        "status": 401,
        "json": {
          "error": "invalid_claims",
          "issues": "name: missing required key\nscope[1]: expected one of \"read\" | \"write\" | \"admin\""
        }
      }
    }
  ]
}