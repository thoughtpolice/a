{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AskRequest": {
      "type": "object",
      "properties": {
        "model": {
          "$ref": "#/$defs/ModelName"
        },
        "state": {
          "$ref": "#/$defs/State"
        },
        "questions": {
          "$ref": "#/$defs/Questions"
        }
      },
      "required": [
        "model",
        "state",
        "questions"
      ],
      "additionalProperties": false,
      "description": "The body of POST /v1/systemone."
    },
    "ChoiceQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "choice"
        },
        "instructions": {
          "$ref": "#/$defs/Entry"
        },
        "criteria": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Criterion"
          },
          "minProperties": 1,
          "maxProperties": 255
        }
      },
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "additionalProperties": false
    },
    "Criterion": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\S"
            },
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "An entry, or null for no description."
    },
    "Entry": {
      "description": "Text, or a non-empty JSON object or array: what instructions and criteria accept.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object",
          "minProperties": 1
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "ModelCard": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "release_date": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "name",
        "description",
        "release_date"
      ],
      "additionalProperties": false
    },
    "ModelList": {
      "type": "object",
      "properties": {
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModelCard"
          }
        }
      },
      "required": [
        "models"
      ],
      "additionalProperties": false
    },
    "ModelName": {
      "type": "string",
      "pattern": "\\S",
      "description": "An alias such as jev-latest, or a versioned ID such as jev-1.13.0."
    },
    "NoulQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "noul"
        },
        "instructions": {
          "$ref": "#/$defs/Entry"
        },
        "criteria": {
          "type": "object",
          "properties": {
            "true": {
              "$ref": "#/$defs/Criterion"
            },
            "false": {
              "$ref": "#/$defs/Criterion"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "type",
        "instructions"
      ],
      "additionalProperties": false
    },
    "Question": {
      "oneOf": [
        {
          "$ref": "#/$defs/NoulQuestion"
        },
        {
          "$ref": "#/$defs/ChoiceQuestion"
        },
        {
          "$ref": "#/$defs/ScoreQuestion"
        }
      ]
    },
    "Questions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/Question"
      },
      "minProperties": 1
    },
    "ScoreQuestion": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "score"
        },
        "instructions": {
          "$ref": "#/$defs/Entry"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "minItems": 2,
          "maxItems": 10
        }
      },
      "required": [
        "type",
        "instructions",
        "criteria"
      ],
      "additionalProperties": false
    },
    "State": {
      "description": "The content to evaluate: text, or a JSON object or array.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array"
        }
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "additionalProperties": false
    }
  }
}
