{
  "formats": {
    "Location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "File path, or binary/section name for RE targets."
        },
        "startLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "First line (1-based), or null."
            },
            {
              "type": "null"
            }
          ]
        },
        "endLine": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Last line (1-based), or null."
            },
            {
              "type": "null"
            }
          ]
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string",
              "description": "Function, method or address, or null."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "startLine",
        "endLine",
        "symbol"
      ],
      "additionalProperties": false
    },
    "Finding": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "A one-line statement of the problem."
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "description": "Impact if exploited, assuming realistic attacker access."
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^CWE-[0-9]+$",
              "description": "The most specific CWE id, such as CWE-89, or null if none fits."
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "File path, or binary/section name for RE targets."
            },
