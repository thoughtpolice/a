              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "description": "First line (1-based), or null."
                },
                {
                  "type": "null"
                }
              ]
            },
            "endLine": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Last line (1-based), or null."
                },
                {
                  "type": "null"
                }
              ]
            },
            "symbol": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "Function, method or address, or null."
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "path",
            "startLine",
            "endLine",
            "symbol"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "string",
          "description": "The code or behaviour that shows the problem, quoted or described precisely."
        },
        "exploitability": {
          "type": "string",
          "description": "How an attacker would reach and trigger it."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Probability that this is a real, reachable issue."
        },
        "remediation": {
          "type": "string",
          "description": "The concrete fix."
        }
      },
      "required": [
        "title",
        "severity",
        "cwe",
        "location",
        "evidence",
        "exploitability",
        "confidence",
        "remediation"
      ],
      "additionalProperties": false
    },
