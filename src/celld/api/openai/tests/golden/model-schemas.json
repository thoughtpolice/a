    "Triage": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "true_positive",
            "false_positive",
            "benign",
            "needs_more_info",
            "duplicate"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "P4"
          ],
          "description": "P0 drop everything, P4 backlog."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string"
        },
        "escalate": {
          "type": "boolean",
          "description": "Whether a human must look at this now."
        },
