load("@root//buck/shims:shims.bzl", depot = "shims")

DEPS = [
    "third-party//rust:serde",
    "third-party//rust:serde_json",
    "third-party//rust:thiserror",
]

depot.rust_library(
    name = "dir-claim",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    tests = [":tests"],
    visibility = ["PUBLIC"],
    deps = DEPS,
)

depot.rust_test(
    name = "tests",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    deps = DEPS + [
        "third-party//rust:tempfile",
    ],
)
