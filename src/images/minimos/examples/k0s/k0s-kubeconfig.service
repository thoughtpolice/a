#
# Hands the cluster's admin kubeconfig to exedev, the account SSH logins
# land in. Nothing on the image can become root, and k0s keeps its own
# copy in a root-only directory. This one lands in
# /var/lib/k0s-kubeconfig, readable by exedev's group, and exedev's
# ~/.kube/config links to it.
#
# The kubeconfig is cluster-admin. Anyone who can log in owns the
# cluster, the same trade as the container host's containerd socket.

[Unit]
Description=Hand the k0s admin kubeconfig to exedev
ConditionVirtualization=!container
After=k0scontroller.service
Requires=k0scontroller.service
PartOf=k0scontroller.service

[Service]
Type=oneshot
RemainAfterExit=yes
# k0s writes certificates a while after it starts, and the command fails
# until then. Bash writes the file, rather than StandardOutput=, which
# systemd would reopen and truncate for ExecStartPost= too. $$ passes a
# literal $ through systemd's own expansion.
ExecStart=/usr/bin/bash -c 'conf=$$(/usr/local/bin/k0s kubeconfig admin) && printf "%%s\n" "$$conf" >/var/lib/k0s-kubeconfig/admin.conf'
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/k0s/kubeconfig-access.conf
Restart=on-failure
RestartSec=10s
UMask=0077

[Install]
WantedBy=k0scontroller.service
