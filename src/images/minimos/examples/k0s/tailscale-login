# Puts this node on the tailnet. exe.dev's tailscale integration holds a
# Tailscale API token outside the VM, so the node mints itself a
# single-use, pre-approved, ephemeral auth key through it and never sees
# the token. tailscaled keeps its node key in /var/lib/tailscale, so a
# reboot reconnects without a new auth key, unless Tailscale has already
# removed the ephemeral node for being offline.

set -euo pipefail

status=$(tailscale status --json --peers=false)
if [[ $status =~ \"BackendState\":\ *\"Running\" ]]; then
    exit 0
fi

name=$(</proc/sys/kernel/hostname)
request='{"capabilities":{"devices":{"create":{"reusable":false,"ephemeral":true,"preauthorized":true}}},"expirySeconds":600,"description":"minimos k0s node '"$name"'"}'
# The key goes to a file in this unit's runtime directory rather than on
# a command line, where any local process could read it.
key_file=$RUNTIME_DIRECTORY/auth-key
code=$(curl -sS --max-time 30 -o "$key_file" -w '%{http_code}' \
    -X POST -H 'Content-Type: application/json' --data "$request" \
    "$TAILSCALE_API/api/v2/tailnet/-/keys")
response=$(<"$key_file")
if [[ $code != 200 || ! $response =~ \"key\":\ *\"(tskey-auth-[^\"]+)\" ]]; then
    echo "tailscale-login: minting an auth key through $TAILSCALE_API failed with HTTP $code: ${response:0:200}" >&2
    exit 1
fi
printf '%s' "${BASH_REMATCH[1]}" >"$key_file"

# MagicDNS and routes stay off. exe.dev writes /etc/resolv.conf, and k0s
# addresses the nodes by tailnet IP. So does Tailscale's firewall. Its
# nftables rules land in the filter, nat and mangle tables that
# iptables-nft uses, in a form iptables-nft-save can't print, and
# Calico's felix gives up on a table it can't read. They only guard
# subnet routes and exit nodes, which the nodes don't use.
tailscale up --auth-key="file:$key_file" --hostname="$name" \
    --accept-dns=false --accept-routes=false --netfilter-mode=off \
    --timeout=2m
: >"$key_file"
