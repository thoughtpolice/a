#
# Where this cluster lives. Every node of one cluster needs the same
# values. t4-start and check-bootstrap read the S3 settings, and
# tailscale-login mints its auth key through TAILSCALE_API.
#
# The S3 settings name an exe.dev S3 integration, which signs requests
# at the edge and is pinned to one bucket. Give each cluster its own
# folder: k0s keeps its CA on each node's disk, not in the datastore, so
# a folder can't be shared between clusters or reused by a new one.
S3_ENDPOINT=https://s3-testing.int.exe.xyz
S3_BUCKET=aseipp-testing
S3_FOLDER=k0s-test/minimos-k0s
# An exe.dev tailscale integration, holding a Tailscale API token.
TAILSCALE_API=https://tailscale.int.exe.xyz
