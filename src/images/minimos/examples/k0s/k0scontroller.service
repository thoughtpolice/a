#
# The k0s controller, with a worker in the same process tree. It's what
# `k0s install controller --enable-worker` would write, baked into the
# image instead. k0s supervises kine, the API server, the scheduler, the
# controller manager, konnectivity, containerd and the kubelet as its
# own children, and unpacks their binaries under /var/lib/k0s/bin.
#
# --no-taints lets pods run here, since every node is a controller.
# containerd runs in this unit's cgroup, not the
# /system.slice/containerd.service k0s tells the kubelet to find it in,
# so --runtime-cgroups points the kubelet's stats at the right place.

[Unit]
Description=k0s controller and worker
Documentation=https://docs.k0sproject.io
# Docker can't give k0s the cgroups, devices and kernel access a
# kubelet needs, so the boot smoke checks this is skipped there.
ConditionVirtualization=!container
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
Slice=kubernetes.slice
ExecStart=/usr/local/bin/k0s controller --config=/etc/k0s/k0s.yaml --enable-worker --no-taints --kubelet-extra-args=--runtime-cgroups=/kubernetes.slice/k0scontroller.service
# The kubelet makes its own cgroups under kubepods.slice, and containerd
# its shims, so systemd has to hand the subtree over. KillMode=process
# leaves the shims and their pods running across a k0s restart, as
# upstream's unit does.
Delegate=yes
KillMode=process
Restart=always
RestartSec=10s
TimeoutStartSec=0
TasksMax=infinity
LimitNOFILE=999999
LimitCORE=0

[Install]
WantedBy=multi-user.target
