[Unit]
Description=containerd container runtime
Documentation=https://containerd.io
# Pulling an image checks a registry certificate, so start after the
# clock. See container@.service for what this ordering does and doesn't
# promise.
After=network.target time-sync.target

[Service]
Type=notify
# Out of system.slice, so shims can't use up the base services' tasks.
# See containers.slice.
Slice=containers.slice
# containerd finds shims through its own PATH. The shim finds nothing
# itself, since runsc-config.toml names runsc by absolute path.
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
ExecStart=/usr/bin/containerd
# Hand the control socket to exedev, the account every SSH login lands
# in. This is the one place the image gives the owner a way to root.
# Anything that can use the socket can start a container that mounts the
# host filesystem, the same trade as Docker's `docker` group.
#
# Without it the owner couldn't even see what's running on a machine
# whose whole job is running containers. gVisor is the boundary under
# the workloads, since every container runs on its userspace kernel
# rather than the host's syscalls.
#
# No `-` prefix. If the handover fails the unit should fail with it.
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/containerd/socket-access.conf
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# containerd places its shims in its own cgroup subtree, and systemd must
# leave that subtree alone.
Delegate=yes
# Stop only the daemon. Shims and running sandboxes survive a containerd
# restart, which is why shims exist.
KillMode=process
OOMScoreAdjust=-999

# Limits, but no sandbox. containerd mounts filesystems, creates devices,
# writes cgroups and enters namespaces for every container, so a systemd
# sandbox tight enough to matter would break it. gVisor is what contains
# the workloads.
#
# These limits bound the daemon and its shims, not containers. The
# runtime puts each sandbox at /sys/fs/cgroup/<namespace>/<id>, outside
# this unit, for the reason nerdctl.toml gives. A container's limits come
# from `--memory`, `--cpus`, `--pids-limit` or `--cgroup-parent`. The
# daemon shares containers.slice's 8192 tasks with the container@ units.
TasksMax=8192
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=0

[Install]
WantedBy=multi-user.target
