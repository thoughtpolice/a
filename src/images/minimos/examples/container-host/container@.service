#
# One sandboxed container, declared as data. Instance %i reads
# /etc/minimos/containers/%i.env, which a layer stacked on this image
# ships along with a multi-user.target.wants/container@<name>.service
# link to enable it:
#
#     # /etc/minimos/containers/web.env
#     IMAGE=docker.io/library/nginx:1.29-alpine@sha256:<digest>
#     RUN_ARGS=--publish 80:80 --memory 256m --cpus 1
#     COMMAND=
#
# Workloads are part of the image, the same as services, because nothing
# on this image can become root at runtime. ctr over SSH can pull and
# inspect but not start a container. The example README explains why.
#
# nerdctl's default runtime is compiled in and names a shim the image
# doesn't ship, so the runtime is given explicitly. The flag makes the
# container start. It doesn't make it sandboxed, since gVisor is the only
# runtime present either way.
#
# The annotation is required. gVisor's shim only connects a container's
# stdio to runsc when the OCI spec has
# io.kubernetes.cri.container-type=sandbox. In pkg/shim/v1/runsc, newInit
# sets p.Sandbox from that annotation alone, and pkg/shim/v1/proc's Create
# passes opts.IO only when p.Sandbox is set. Without it the shim reads
# runsc's output through a pipe the sandbox inherits and never closes, so
# Create blocks forever. The sandbox logs "Watchdog.Start() not called
# within 30s" and the task never starts. CRI clients always set it, and
# nerdctl and ctr have to be told.

[Unit]
Description=Sandboxed container %i
Documentation=https://gvisor.dev/docs/user_guide/containerd/
# time-sync.target only means chronyd has started, not that the clock has
# converged. With no chronyc and no chrony-wait.service there is nothing
# better to wait on. The ordering still belongs here, because a pull
# checks a registry certificate against the clock.
After=containerd.service network.target time-sync.target
Requires=containerd.service
PartOf=containerd.service

[Service]
Type=simple
# Beside containerd, out of system.slice. See containers.slice.
Slice=containers.slice
EnvironmentFile=/etc/minimos/containers/%i.env
Environment=PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
# Every other input to these images is pinned by hash. A workload image
# comes from a registry at runtime, and a tag can move between the boot
# that was tested and the boot that runs. TLS proves who served the
# bytes, not that they're the bytes you tested. So IMAGE has to name a
# digest.
ExecStartPre=/usr/bin/bash -c 'case "$IMAGE" in *@sha256:*) exit 0 ;; esac; echo "IMAGE must be pinned by digest (…@sha256:…), got: ${IMAGE:-<unset>}" >&2; exit 1'
# Remove a container an unclean stop left behind, or its name would
# collide. Usually there's nothing to remove and nerdctl fails, so its
# error stays out of the journal.
ExecStartPre=-/usr/bin/bash -c '/usr/bin/nerdctl rm --force %i 2>/dev/null || true'
# Container stdout goes to a json-file log on disk, and cgroups bound
# memory, CPU and pids but never bytes written. An unbounded log is the
# likeliest way this host fills its disk. --log-opt comes before
# $RUN_ARGS so a workload can override it.
ExecStart=/usr/bin/nerdctl run --rm --quiet --name %i --runtime=io.containerd.runsc.v1 --annotation io.kubernetes.cri.container-type=sandbox --log-opt max-size=16m --log-opt max-file=3 $RUN_ARGS $IMAGE $COMMAND
ExecStop=-/usr/bin/nerdctl stop %i
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=container-%i

# These limits bound the nerdctl process, not the container. The runtime
# puts the sandbox at /sys/fs/cgroup/<namespace>/<id>, outside this unit,
# for the reason nerdctl.toml gives. Container limits go in RUN_ARGS as
# `--memory`, `--cpus`, `--pids-limit` or `--cgroup-parent`.
TasksMax=512
LimitCORE=0
