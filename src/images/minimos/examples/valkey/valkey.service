[Unit]
Description=Valkey key-value store
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/valkey-server /etc/valkey/valkey.conf
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# MemoryHigh= starts reclaim before the hard cap, and the gap covers
# allocator and connection overhead.
Slice=user-workload.slice
CPUWeight=100
IOWeight=100
MemoryHigh=192M
MemoryMax=256M
MemorySwapMax=0
TasksMax=64
OOMPolicy=kill

# The same sandbox as memcached.service. StateDirectory= creates
# /var/lib/valkey, valkey.conf's `dir`, owned by the dynamic user.
DynamicUser=yes
StateDirectory=valkey
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# valkey.conf binds loopback, so the service gets no other network.
IPAddressDeny=any
IPAddressAllow=localhost
PrivateDevices=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=077

[Install]
WantedBy=multi-user.target
