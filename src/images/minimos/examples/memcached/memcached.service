[Unit]
Description=memcached in-memory object cache
After=network.target

[Service]
Type=simple
# Loopback only. Check it from inside the VM with bash builtins:
#   exec 3<>/dev/tcp/127.0.0.1/11211; printf 'version\r\n' >&3; read -r v <&3; echo "$v"
# DynamicUser= means the service never starts as root, so memcached's
# refusal to run as root never trips and `-u` isn't needed.
ExecStart=/usr/bin/memcached -l 127.0.0.1 -p 11211 -m 64
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal

# The 64 MiB item cache set above leaves room under the hard limit for
# connections, threads, the hash table and allocator overhead.
Slice=user-workload.slice
CPUWeight=100
IOWeight=100
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=0
TasksMax=64
OOMPolicy=kill

# The sandbox every minimos service starts from. DynamicUser= implies
# NoNewPrivileges=, ProtectSystem=strict, ProtectHome=read-only,
# PrivateTmp=, RemoveIPC= and RestrictSUIDSGID=. ProtectHome=yes below
# hides /home entirely.
DynamicUser=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# The service binds loopback, so it gets no other network.
IPAddressDeny=any
IPAddressAllow=localhost
PrivateDevices=yes
PrivateIPC=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
UMask=077

[Install]
WantedBy=multi-user.target
