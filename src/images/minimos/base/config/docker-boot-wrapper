# The boot smoke's entrypoint. Docker mounts the container's private
# cgroup v2 namespace read-only, and systemd needs to build its hierarchy
# there. This remounts that one view writable and then runs the image's
# Cmd unchanged. Nothing uses it on a VM.

set -euo pipefail

unset BASH_ENV ENV CDPATH GLOBIGNORE LD_LIBRARY_PATH LD_PRELOAD
export PATH=/usr/bin:/usr/sbin:/bin:/sbin

if [[ $# -eq 0 ]]; then
    echo "minimos docker boot wrapper: image Cmd is empty" >&2
    exit 2
fi

/usr/bin/mount -o remount,rw,nosuid,nodev,noexec /sys/fs/cgroup
builtin exec "$@"
