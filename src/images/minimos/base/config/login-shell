# exedev's login shell. exe.dev starts its SSH listener before PID 1, so
# every SSH child starts in init.scope, outside the user slices. Dev
# images ship /etc/minimos/require-user-scope, and there each command and
# shell moves into a bounded scope under the lingering user manager, or
# the login is refused. Appliance images have no user manager and get
# plain Bash with core dumps off, enough for systemctl and journalctl.

set -euo pipefail

unset BASH_ENV ENV CDPATH GLOBIGNORE LD_LIBRARY_PATH LD_PRELOAD
umask 077
ulimit -S -c 0
ulimit -H -c 0

export HOME=/home/exedev
export USER=exedev
export LOGNAME=exedev
export SHELL=/bin/bash
export PATH=/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
export XDG_RUNTIME_DIR=/run/user/1000
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

if [[ $# -eq 0 ]]; then
    command=(/bin/bash --login)
else
    command=(/bin/bash "$@")
fi

if [[ -e /etc/minimos/require-user-scope ]]; then
    if [[ ! -S /run/user/1000/bus ]]; then
        echo "minimos: bounded user manager is not ready; refusing an unscoped login" >&2
        exit 1
    fi
    builtin exec /usr/bin/systemd-run \
        --user \
        --scope \
        --collect \
        --quiet \
        --expand-environment=no \
        --property="Delegate=cpu cpuset io memory pids" \
        --property=CPUWeight=100 \
        --property=IOAccounting=yes \
        --property=IOWeight=100 \
        --property=MemoryAccounting=yes \
        --property=MemoryHigh=65% \
        --property=MemoryMax=75% \
        --property=MemorySwapMax=0 \
        --property=TasksAccounting=yes \
        --property=TasksMax=2048 \
        "${command[@]}"
fi

builtin exec "${command[@]}"
