#
# Runs the script given to `ssh exe.dev new --setup-script`, which the
# platform writes to /exe.dev/setup. exe.dev documents it as running once
# at first boot, but the platform writes the file back on every boot, so
# this unit runs it again each time. Setup scripts need to be safe to run
# twice.
#
# The script runs as exedev with no capabilities and a read-only system,
# so it can set up /home/exedev and nothing else. Anything system-wide
# belongs in the image.

[Unit]
Description=Run the exe.dev setup script
ConditionPathExists=/exe.dev/setup
Wants=minimos-harden.service
After=minimos-harden.service network.target

[Service]
Type=oneshot
User=exedev
Group=exedev
Slice=user-workload.slice
WorkingDirectory=/home/exedev
# bash reads the file itself, so the script needs no exec bit and no #!
# line that resolves here. The base has no /usr/bin/env, for one.
ExecStart=/bin/bash /exe.dev/setup
# Delete the script once it has run, as the stock image does with
# `sudo rm`, so any secrets in it don't stay on disk. There is no rm here,
# so systemd-tmpfiles does the unlink, and the `+` runs it as root because
# /exe.dev belongs to root. ExecStopPost= runs even when the script fails.
ExecStopPost=-+/usr/bin/systemd-tmpfiles --remove /usr/lib/minimos/exe-setup-clean.conf
Environment=HOME=/home/exedev
Environment=USER=exedev
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/exedev /exe.dev
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=077
CPUWeight=100
IOWeight=100
MemoryHigh=50%
MemoryMax=70%
MemorySwapMax=0
TasksMax=1024
OOMPolicy=kill
TimeoutStartSec=5min
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exe-setup
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
