[Unit]
Description=Clock discipline from the hypervisor PTP device (chrony)
Documentation=man:chronyd(8) man:chrony.conf(5)
# A container shares the host's clock and has no business setting it,
# which also keeps this unit out of the docker boot smoke. `!container`
# rather than `vm` so a hypervisor systemd can't identify still gets a
# disciplined clock.
ConditionVirtualization=!container
# /dev/ptp0 is the only source chrony.conf names. Without it the unit is
# skipped, and `systemctl status` shows the failed condition, instead of
# running with no source and looking healthy.
ConditionPathExists=/dev/ptp0
Wants=time-sync.target
Before=time-sync.target

[Service]
Type=notify
# /dev/ptp0 is a devtmpfs node owned 0600 root:root, and there is no udev
# to change that. The `+` runs this one command as root to hand the
# device to the chrony group. See chrony-ptp.conf for why the list lives
# outside tmpfiles.d.
#
# /var/lib/chrony is baked into the image owned by chrony instead of
# declared as StateDirectory=. systemd resets an Exec directory's owner
# on every exec, the main one included, so a chown from here would be
# undone before chronyd wrote its drift file.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /usr/lib/minimos/chrony-ptp.conf
ExecStart=/usr/bin/chronyd -n -f /etc/chrony/chrony.conf
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# chronyd starts as root and drops to the chrony account on its own. Wolfi
# compiles in `-u chrony`, which is why that account exists. User=chrony
# with an ambient CAP_SYS_TIME doesn't work, because chronyd checks for
# uid 0 rather than the capability and exits with "Fatal error : Not
# superuser".
#
# The bounding set is CAP_SYS_TIME plus the two capabilities the drop
# itself needs. setgroups() requires CAP_SETGID even as uid 0, and
# without it chronyd exits with "Fatal error : setgroups() failed". After
# the drop chronyd holds CAP_SYS_TIME and nothing else.
CapabilityBoundingSet=CAP_SYS_TIME CAP_SETUID CAP_SETGID
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# Only the PTP device, next to the null/zero/full/random/urandom/tty set
# that DevicePolicy=closed always allows.
DevicePolicy=closed
DeviceAllow=char-ptp r

# chronyd needs no network at all, so the kernel enforces that instead of
# trusting chrony.conf to stay free of servers.
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

# ProtectSystem=strict needs to be told the baked state directory is
# writable. /run/chrony holds only the pidfile, which chronyd writes
# before the drop, so root ownership is fine.
RuntimeDirectory=chrony
ProtectSystem=strict
ReadWritePaths=/var/lib/chrony
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# @clock adds adjtimex, clock_settime and clock_adjtime, which
# @system-service leaves out. capset lets chronyd drop the capabilities
# it doesn't keep. @privileged would also allow mount, chroot and the rest
# of the root syscalls.
SystemCallFilter=@system-service @clock capset
SystemCallErrorNumber=EPERM
UMask=077

# No ProtectClock=yes, unlike every other unit here. It would silently
# block the one syscall this service exists to make.

# chronyd is one process and a few megabytes.
MemoryHigh=48M
MemoryMax=64M
MemorySwapMax=0
TasksMax=16

[Install]
WantedBy=multi-user.target
