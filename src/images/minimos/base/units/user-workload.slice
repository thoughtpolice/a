[Unit]
Description=Bounded minimos application workloads
Before=slices.target

[Slice]
# The user- prefix makes this a child of user.slice, so application
# services and interactive scopes share its 80% memory and 3072-task
# ceiling rather than each getting a top-level cap of their own.
CPUWeight=100
IOWeight=100
MemoryHigh=65%
MemoryMax=70%
MemorySwapMax=0
# Repeated in 90-minimos-qos.conf. systemd's user-.slice.d/10-defaults.conf
# matches this slice's name too, and its TasksMax=33% would otherwise
# replace this value.
TasksMax=2048
