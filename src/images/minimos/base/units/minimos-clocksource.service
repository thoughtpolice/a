[Unit]
Description=Keep time with kvm-clock instead of the TSC
Documentation=https://github.com/boldsoftware/exe.dev/issues/222
# Cloud Hypervisor tells the guest its TSC is invariant, so the kernel
# picks it over kvm-clock. It doesn't keep the vCPUs' TSCs in step,
# though. After months of uptime they drift apart, and CLOCK_MONOTONIC
# jumps back by up to a millisecond whenever a process moves to another
# vCPU. That crashed Chromium on an exe.dev VM, and switching that VM to
# kvm-clock fixed it, at about 120 ns more per clock_gettime.
#
# The clocksource is host-global, so a container must never switch it.
# `!container` for the same reason as minimos-harden.service.
DefaultDependencies=no
ConditionVirtualization=!container
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
# A kernel that doesn't offer kvm-clock, as when it isn't running under
# KVM, skips the unit rather than failing it.
ExecCondition=/usr/bin/bash -c '[[ " $(</sys/devices/system/clocksource/clocksource0/available_clocksource) " == *" kvm-clock "* ]]'
ExecStart=/usr/bin/bash -c 'echo kvm-clock >/sys/devices/system/clocksource/clocksource0/current_clocksource'
# The kernel accepts any name here and only logs when it can't switch,
# so read back what it chose.
ExecStartPost=/usr/bin/bash -c 'current=$(</sys/devices/system/clocksource/clocksource0/current_clocksource); [[ "$current" == kvm-clock ]] || { echo "minimos: the kernel kept $current as its clocksource" >&2; exit 1; }'
RemainAfterExit=yes

# root owns the sysfs file, so the write needs no capability.
CapabilityBoundingSet=
NoNewPrivileges=yes

[Install]
WantedBy=sysinit.target
