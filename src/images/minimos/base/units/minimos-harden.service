[Unit]
Description=Apply VM-only kernel hardening sysctls
# These keys are host-global, and kernel.modules_disabled stays set until
# reboot. Under docker the boot smoke shares the host's kernel, so a
# container must never apply them.
#
# `!container` rather than `vm` so a hypervisor systemd can't identify
# still gets hardened. With `vm` that VM would skip the whole tier, and a
# skipped unit doesn't show up as failed.
DefaultDependencies=no
ConditionVirtualization=!container
Wants=systemd-sysctl.service
After=systemd-sysctl.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/lib/systemd/systemd-sysctl /usr/lib/minimos/sysctl-vm.conf
# systemd-sysctl logs a key it can't set and carries on, so a clean exit
# proves nothing. Read back the one that matters most, which is minimos's
# stand-in for Bottlerocket's kernel lockdown.
ExecStartPost=/usr/bin/bash -c '[[ "$(</proc/sys/kernel/modules_disabled)" == 1 ]] || { echo "minimos: VM hardening sysctls did not apply" >&2; exit 1; }'
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
