{
  "rust-analyzer": {
    "command": "rust-analyzer",
    "extensionToLanguage": {
      ".rs": "rust"
    },
    "initializationOptions": {
      "check": {
        "overrideCommand": ["/bin/sh", "-c", "exec \"$(buck2 root --kind project)/buck/toolchains/rust/lsp/rust-project\" check \"$1\"", "rust-project", "$saved_file"]
      },
      "workspace": {
        "discoverConfig": {
          "command": ["/bin/sh", "-c", "exec \"$(buck2 root --kind project)/buck/toolchains/rust/lsp/rust-project\" discover \"$1\"", "rust-project", "{arg}"],
          "progressLabel": "rust-analyzer[buck2]",
          "filesToWatch": ["BUILD", "PACKAGE"]
        }
      }
    }
  },
  "lean": {
    "command": "/bin/sh",
    "args": ["-c", "exec \"$(buck2 root --kind project)/buck/toolchains/lean/lsp/lake\" serve"],
    "extensionToLanguage": {
      ".lean": "lean4"
    }
  },
  "gopls": {
    "command": "/bin/sh",
    "args": ["-c", "exec \"$(buck2 root --kind project)/buck/toolchains/golang/lsp/gopls\""],
    "extensionToLanguage": {
      ".go": "go"
    },
    "initializationOptions": {
      "directoryFilters": ["-buck-out", "-work", "-**/node_modules"]
    }
  }
}
