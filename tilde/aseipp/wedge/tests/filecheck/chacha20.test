// The fixture is a real program: WABT's interpreter must reproduce the RFC
// 8439 vectors before the compiler's view of it means anything.
// RUN: %wat2wasm %S/../chacha20.wat -o %t.wasm && %{wasm-interp} %t.wasm --run-export=selftest | FileCheck %s --check-prefix=INTERP
// RUN: %wedge --emit cfg %t.wasm | FileCheck %s
// RUN: %wedge --emit ir %t.wasm | FileCheck %s --check-prefix=IR

// INTERP: selftest() => i32:0

// The block function keeps the sixteen state words and the round counter as
// parameters of a single-block loop, and the back edge carries the diagonal
// round's results.
// CHECK-LABEL: func func1 exports=["chacha20_block"] entry=block0 root=region0 {
// CHECK: block block1 region=region1 params=[%21:i32, %22:i32, %23:i32, %24:i32, %29:i32, %30:i32, %31:i32, %32:i32, %37:i32, %38:i32, %39:i32, %40:i32, %45:i32, %46:i32, %47:i32, %48:i32, %69:i32] reachable=true rpo=1 idom=block0 ipdom-semantic=virtual-exit ipdom-normal=block3 scc=scc1 cyclic=true incoming=[edge0, edge1] outgoing=[edge1, edge2]
// CHECK: edge edge1 block1 -> block1 kind=branch.true args=[%53, %66, %63, %60, %57, %54, %67, %64, %61, %58, %55, %68, %65, %62, %59, %56, %71] refined=[]
// CHECK: loop header=block1 blocks=[block1] backedges=[edge1]

// The stream cipher's byte loop nests inside its block loop.
// CHECK-LABEL: func func2 exports=["chacha20_xor"] entry=block0 root=region0 {
// CHECK: region region2 kind=loop parent=region1 entry=block3
// CHECK-NEXT: region region3 kind=loop parent=region2 entry=block6
// CHECK: loop header=block3 blocks=[block3, block5, block6, block7, block8] backedges=[edge7]
// CHECK-NEXT: loop header=block6 blocks=[block6] backedges=[edge5]

// The quarter round is straight-line pure arithmetic returning four words.
// IR-LABEL: func func0 wasm-index=0 : type0 defined
// IR: block0(%0: i32, %1: i32, %2: i32, %3: i32) [region0]
// IR-NEXT: %4: i32 = i32.add(%0, %1) ; inst0
// IR-NEXT: %5: i32 = i32.xor(%3, %4) ; inst1
// IR-NEXT: %6: i32 = i32.const<s32=16>() ; inst2
// IR-NEXT: %7: i32 = i32.rotl(%5, %6) ; inst3
// IR: return %12 %19 %16 %15
