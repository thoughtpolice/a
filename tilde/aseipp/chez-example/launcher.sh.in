#!/usr/bin/env bash
# SPDX-FileCopyrightText: © 2024-2026 Austin Seipp
# SPDX-License-Identifier: Apache-2.0
#
# Runs @APPNAME@ from the binary distribution this script is in: the boot
# files and the companion C library sit beside the executable.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$DIR/../lib/@APPNAME@/@VERSION@"
export APP_RTS_CLIBDIR="$LIB"
export SCHEMEHEAPDIRS="$LIB"
exec "$LIB/@APPNAME@.exe" "$@"
