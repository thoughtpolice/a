# dotnet/runtime's BigInteger.cs, as the gameplay CoreLib compiles it
# (corelib/BigInteger.cs): a GC array of nuint limbs cannot be seen as
# bytes or 32-bit words, so the constructor from bytes reads each limb a
# byte at a time, TryGetBytes always takes its limb-by-limb loop, and a
# rotation swaps the limbs' words through the CoreLib's
# SwapUpperAndLowerWords. coresurface applies it (--patch).
--- a/BigInteger.cs
+++ b/BigInteger.cs
@@ -409,23 +409,19 @@
