;; vim.ss -- Vim's keys (the key scheme 'vim)
;;
;; SPDX-FileCopyrightText: © 2024-2026 Austin Seipp
;; SPDX-License-Identifier: Apache-2.0

(headless-start! 12 60)
(set-var! 'key-scheme 'vim)
(check "Vim's keys are in use" (eq? (key-scheme-name (current-key-scheme)) 'vim))

(define (cursor) (sel-start (car (view-sels (current-view)))))
(define (fresh! text) (headless-buffer! text 'text) (set-sels! (current-buffer) (list (make-sel 0 1))))

;; Motions.
(fresh! "hello world foo\nsecond line here\n")
(press! "w")
(expect-equal "w" (cursor) 6)
(press! "e")
(expect-equal "e" (cursor) 10)
(press! "b")
(expect-equal "b" (cursor) 6)
(press! "$")
(expect-equal "$" (cursor) 14)
(press! "0")
(expect-equal "0" (cursor) 0)
(press! "j")
(expect-equal "j" (cursor) 16)
(press! "2" "w")
(expect-equal "a count" (cursor) 28)
(press! "g" "g")
(expect-equal "gg" (cursor) 0)
(press! "G")
(expect-equal "G: the last line, not the end after it" (cursor) 16)
(press! "g" "g" "f" "o")
(expect-equal "f" (cursor) 4)
(press! ";")
(expect-equal ";" (cursor) 7)

;; Operators, with motions, objects and themselves.
(fresh! "one two three\nfour five\n")
(press! "d" "w")
(expect-equal "dw" (buffer-contents) "two three\nfour five\n")
(press! "c" "w")
(type! "TWO")
(press! "esc")
(expect-equal "cw" (buffer-contents) "TWO three\nfour five\n")
(press! "d" "d")
(expect-equal "dd" (buffer-contents) "four five\n")
(press! "p")
(expect-equal "p after dd" (buffer-contents) "four five\nTWO three\n")
(press! "u")
(expect-equal "u" (buffer-contents) "four five\n")
(fresh! "call(alpha, beta)")
(press! "f" "a" "f" "a")
(press! "d" "i" "(")
(expect-equal "di(" (buffer-contents) "call()")
(fresh! "say \"hi there\" now")
(press! "f" "h" "c" "i" "\"")
(type! "yo")
(press! "esc")
(expect-equal "ci\"" (buffer-contents) "say \"yo\" now")
(fresh! "abc def")
(press! "x")
(expect-equal "x" (buffer-contents) "bc def")
(press! "y" "i" "w" "$" "p")
(expect-equal "yiw then p" (buffer-contents) "bc defbc")
(press! "r" "Z")
(expect-equal "r" (buffer-contents) "bc defbZ")

;; Visual mode: v, a motion, an operator.
(fresh! "alpha beta gamma")
(press! "v" "e" "d")
(expect-equal "v e d" (buffer-contents) " beta gamma")
(press! "w" "V" "y")
(expect-equal "V y yanks the line" (register-fetch) '((" beta gamma") . #t))

;; Insert: i a A o.
(fresh! "mid")
(press! "A")
(type! "!")
(press! "esc" "I")
(type! ">")
(press! "esc" "o")
(type! "next")
(press! "esc")
(expect-equal "A I o" (buffer-contents) ">mid!\nnext")

;; Ex: a line number, and :s are not here, but :N is.
(fresh! "1\n2\n3\n")
(press! ":")
(type! "3")
(press! "enter")
(expect-equal ":3" (cursor) 4)

;; Counts after an operator, and before it too: they multiply.
(fresh! "a b c d e f g h i j")
(press! "d" "2" "w")
(expect-equal "d2w" (buffer-contents) "c d e f g h i j")
(press! "2" "d" "3" "w")
(expect-equal "2d3w" (buffer-contents) "i j")
(fresh! "1\n2\n3\n4\n5\n")
(press! "d" "3" "d")
(expect-equal "d3d" (buffer-contents) "4\n5\n")
(fresh! "abc def")
(press! "w" "d" "0")
(expect-equal "d0" (buffer-contents) "def")

;; Registers: named ones, appending to one, the yank register, the
;; numbered ones for deleted lines, the black hole.
(fresh! "one\ntwo\nthree\n")
(press! "\"" "a" "y" "y" "j" "\"" "b" "y" "y")
(press! "j" "\"" "a" "p")
(expect-equal "\"ap" (buffer-contents) "one\ntwo\nthree\none\n")
(press! "\"" "A" "y" "y" "\"" "a" "P")
(expect-equal "\"A adds lines" (buffer-contents) "one\ntwo\nthree\none\none\none\n")
(fresh! "one\ntwo\nthree\n")
(press! "y" "y" "j" "d" "d" "d" "d")
(expect-equal "deleted" (buffer-contents) "one\n")
(press! "\"" "0" "p" "\"" "2" "p")
(expect-equal "\"0 the yank, \"2 the delete before last" (buffer-contents) "one\none\ntwo\n")
(press! "\"" "_" "d" "d" "p")
(expect-equal "\"_ keeps nothing" (buffer-contents) "one\none\nthree\n")
(press! "\"" "1" "p" "\"" "z" "p")
(expect-equal "an empty register puts nothing" (buffer-contents) "one\none\nthree\nthree\n")

;; . repeats the last change: an operator and its motion, an insert and
;; what was typed, a count of its own or a new one; not a motion, a yank
;; or an undo.
(fresh! "a b c d e f g h")
(press! "d" "w" "." "j" "y" "w" "u" ".")
(expect-equal ". after dw, u undoing the ." (buffer-contents) "c d e f g h")
(press! "2" "d" "w" ".")
(expect-equal "2dw ." (buffer-contents) "g h")
(fresh! "a b c d e f g h")
(press! "2" "d" "w" "3" ".")
(expect-equal "3. instead of 2dw's count" (buffer-contents) "f g h")
(fresh! "x\ny\n")
(press! "A")
(type! "!!")
(press! "esc" "j" ".")
(expect-equal ". an insert" (buffer-contents) "x!!\ny!!\n")
(fresh! "one two")
(press! "c" "w")
(type! "1")
(press! "esc" "w" ".")
(expect-equal ". a change" (buffer-contents) "1 1")
(fresh! "abcdef")
(press! "x" "l" "." "." "u")
(expect-equal "undo after ." (buffer-contents) "bdef")
(fresh! "a\nb\nc\n")
(press! "\"" "q" "y" "y" "j" "\"" "q" "p" "j" ".")
(expect-equal ". a put from a register" (buffer-contents) "a\nb\na\nc\na\n")

;; Macros: q records into a register until q, @ plays it, a count plays
;; it more, @@ again; one runs others; replayed keys are not recorded.
(fresh! "1\n2\n3\n4\n5\n6\n")
(press! "q" "a" "A")
(type! ",")
(press! "esc" "j" "q")
(expect-equal "recorded, done once" (buffer-contents) "1,\n2\n3\n4\n5\n6\n")
(press! "@" "a")
(expect-equal "@a" (buffer-contents) "1,\n2,\n3\n4\n5\n6\n")
(press! "2" "@" "a")
(expect-equal "2@a" (buffer-contents) "1,\n2,\n3,\n4,\n5\n6\n")
(press! "@" "@")
(expect-equal "@@" (buffer-contents) "1,\n2,\n3,\n4,\n5,\n6\n")
(press! "q" "b" "@" "a" "q")
(expect-equal "recording one that runs another" (buffer-contents) "1,\n2,\n3,\n4,\n5,\n6,\n")
(press! "g" "g" "@" "b")
(expect-equal "@b runs @a" (buffer-contents) "1,,\n2,\n3,\n4,\n5,\n6,\n")
(press! "j" ".")
(expect-equal ". after a macro: its last change" (buffer-contents) "1,,\n2,\n3,,\n4,\n5,\n6,\n")
(press! "q" "c" "@" "c" "q" "@" "c")
(check "a macro that runs itself stops" #t)

;; Back to Ki's keys.
(set-var! 'key-scheme 'ki)
(check "Ki's again" (eq? (key-scheme-name (current-key-scheme)) 'ki))
