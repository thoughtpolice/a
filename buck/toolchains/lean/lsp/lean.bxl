"""Queries the Lean language server shim (lake.py) asks of Buck.

  target   the Lean target owning a source file, its package and options,
           every module it can import, the built import graphs and the
           precompiled libraries it loads
  build    build the given modules of a target's import closure and print
           where their artifacts are
  index    the source roots of every Lean target, for LEAN_SRC_PATH, the
           include flags naming the build's Lean, and with --build true where
           each module that builds keeps its .ilean
"""

load("@toolchains//lean:defs.bzl", "LeanLibraryInfo")

def _owners(ctx: bxl.Context, file: str):
    universe = ctx.target_universe(ctx.uquery().owner(file))
    return ctx.cquery().kind("^lean_modules$", ctx.cquery().owner(file, universe.target_set()))

def _target_impl(ctx: bxl.Context) -> None:
    nodes = _owners(ctx, ctx.cli_args.file)
    if len(nodes) == 0:
        ctx.output.print_json({})
        return

    # A file can belong to more than one target (a test and a library, say);
    # any of them describes its imports.
    node = list(nodes)[0]
    info = ctx.analysis(node).providers()[LeanLibraryInfo]
    graphs = ctx.output.ensure_multiple(info.graphs)
    dynlibs = ctx.output.ensure_multiple(info.dynlibs)
    module = None
    for name in info.own:
        if get_path_without_materialization(info.modules[name].src, ctx, abs = True) == ctx.cli_args.file:
            module = name
    ctx.output.print_json({
        "dynlibs": [d.abs_path() for d in dynlibs],
        "graphs": [g.abs_path() for g in graphs],
        "module": module,
        "modules": sorted(info.modules.keys()),
        "options": info.options,
        "package": info.package,
        "target": str(node.label.raw_target()),
    })

def _build_impl(ctx: bxl.Context) -> None:
    node = ctx.configured_targets(ctx.cli_args.target)
    info = ctx.analysis(node).providers()[LeanLibraryInfo]
    out = {}
    for name in ctx.cli_args.module:
        m = info.modules[name]
        elab, sig, ir = ctx.output.ensure_multiple([m.elab, m.sig, m.ir])
        out[name] = [elab.abs_path(), sig.abs_path(), ir.abs_path()]
    ctx.output.print_json(out)

def _index_impl(ctx: bxl.Context) -> None:
    nodes = ctx.cquery().kind("^lean_modules$", ctx.target_universe(ctx.cli_args.pattern).target_set())
    roots = {}
    labels = {}
    for node in nodes:
        info = ctx.analysis(node).providers()[LeanLibraryInfo]
        for name in info.own:
            src = info.modules[name].src
            path = get_path_without_materialization(src, ctx, abs = True)
            suffix = name.replace(".", "/") + ".lean"
            roots[path[:-len(suffix)].rstrip("/")] = True
            labels[name] = node.label.with_sub_target(["elab", name])

    # The directory holding every module's .ilean (NAME.ilean), for
    # find-references across the repository. A
    # module that fails to build (an unfinished proof, say) is left out
    # rather than failing the editor's start.
    ileans = {}
    failed = []
    if ctx.cli_args.build:
        results = ctx.build(labels.values())
        for name, label in labels.items():
            result = results[label]
            if len([f for f in result.failures()]) > 0:
                failed.append(name)
                continue
            for elab in ctx.output.ensure_multiple(result.artifacts()):
                ileans[name] = elab.abs_path()

    # The include flags toolchains//lean:check found, which name the Lean
    # the build uses. The server runs that one too, whatever is on PATH.
    check = ctx.analysis(ctx.configured_targets("toolchains//lean:check")).providers()[DefaultInfo]
    cflags = ctx.output.ensure(check.sub_targets["cflags"][DefaultInfo].default_outputs[0])

    ctx.output.print_json({
        "cflags": cflags.abs_path(),
        "failed": sorted(failed),
        "ileans": ileans,
        "roots": sorted(roots.keys()),
    })

target = bxl_main(
    impl = _target_impl,
    cli_args = {
        "file": cli_args.string(doc = "Absolute path of a source file"),
    },
)

build = bxl_main(
    impl = _build_impl,
    cli_args = {
        "module": cli_args.list(cli_args.string()),
        "target": cli_args.string(),
    },
)

index = bxl_main(
    impl = _index_impl,
    cli_args = {
        "build": cli_args.bool(default = False, doc = "Build every module and list its .ilean"),
        "pattern": cli_args.list(cli_args.string()),
    },
)
