load("@root//buck/shims:package.bzl", "pkg")

pkg.info(
    description = """
        Pinned packages from Wolfi, Chainguard's glibc-based rolling
        "undistro" (https://wolfi.dev). Each target downloads one .apk
        (hash-verified); consumers unpack them into rootfs layers via
        src/images/minimos machinery. Individual package versions are
        pinned in BUILD — there is no single collection version.
    """,
    license = 'Apache-2.0',
    copyright = [
        "2022-2026 Chainguard, Inc. and the Wolfi contributors",
    ],
    visibility = ['PUBLIC'],
    # The .apk files come from the x86_64 repository only (see wolfi.bzl),
    # matching the linux/amd64 images minimos emits for exe.dev.
    target_compatible_with = [
        "config//os:linux",
        "config//cpu:x86_64",
    ],
)
