/*
 * The config-host.h meson.build would write for this build: an x86_64
 * Linux host, glibc, clang, the system emulators only, and the libraries in
 * third-party// (glib, pixman, libfdt, libslirp, zlib). A setting that
 * meson.build leaves false is left out, as meson leaves it #undef.
 *
 * The host checks were answered by compiling meson.build's own probe
 * programs, or its has_header/has_function equivalents, with the
 * toolchain's clang against glibc 2.42. They hold for glibc 2.34 or newer
 * (close_range, the newest function used here, arrived in 2.34).
 *
 * As in meson's output, a setting meson.build makes from a boolean is defined
 * empty, and only the ones it sets to a number have a value: QEMU's
 * IS_ENABLED() is true only of an empty definition.
 *
 * The @VERSION@ placeholders come from PACKAGE.
 */

/* Host */
#define HOST_X86_64 1
#define CONFIG_LINUX
#define CONFIG_POSIX
#define CONFIG_EPOLL
#define HAVE_HOST_BLOCK_DEVICE
#define CONFIG_HOST_DSOSUF ".so"

/* Version */
#define QEMU_VERSION "@VERSION@"
#define QEMU_VERSION_MAJOR @VERSION_MAJOR@
#define QEMU_VERSION_MINOR @VERSION_MINOR@
#define QEMU_VERSION_MICRO @VERSION_MICRO@

/*
 * Installation paths, under meson's default prefix. CONFIG_RELOCATABLE makes
 * QEMU resolve them against the directory of its executable, so the
 * firmware search path is ../share/qemu next to the binary.
 */
#define CONFIG_RELOCATABLE
#define CONFIG_PREFIX "/usr/local"
#define CONFIG_BINDIR "/usr/local/bin"
#define CONFIG_QEMU_CONFDIR "/usr/local/etc/qemu"
#define CONFIG_QEMU_DATADIR "/usr/local/share/qemu"
#define CONFIG_QEMU_DESKTOPDIR "/usr/local/share/applications"
#define CONFIG_QEMU_FIRMWAREPATH "/usr/local/share/qemu-firmware",
#define CONFIG_QEMU_HELPERDIR "/usr/local/libexec"
#define CONFIG_QEMU_ICONDIR "/usr/local/share/icons"
#define CONFIG_QEMU_LOCALEDIR "/usr/local/share/locale"
#define CONFIG_QEMU_LOCALSTATEDIR "/usr/local/var"
#define CONFIG_QEMU_MODDIR "/usr/local/lib/qemu"
#define CONFIG_SYSCONFDIR "/usr/local/etc"
#define CONFIG_SMBD_COMMAND "/usr/sbin/smbd"

/* Accelerators. KVM itself is per target, in config-target.h. */
#define CONFIG_TCG 1
#define CONFIG_KVM_TARGETS "i386-softmmu" ,"x86_64-softmmu"

/*
 * Features and libraries: everything else meson.build can turn on (audio
 * drivers, GUIs, TLS, compression, vhost, io_uring, modules, plugins, ...) is
 * off.
 */
#define CONFIG_AUDIO_DRIVERS "",
#define CONFIG_BDRV_RO_WHITELIST
#define CONFIG_BDRV_RW_WHITELIST
#define CONFIG_FDT
#define CONFIG_L2TPV3
#define CONFIG_PIXMAN
#define CONFIG_SECRET_KEYRING
#define CONFIG_SLIRP
#define CONFIG_TPM
#define CONFIG_VNC
#define CONFIG_TLS_PRIORITY "NORMAL"
#define CONFIG_TRACE_LOG
#define CONFIG_TRACE_FILE "trace"

/* Options at QEMU's defaults */
#define CONFIG_ASAN_IFACE_FIBER
#define CONFIG_COROUTINE_POOL
#define CONFIG_QOM_CAST_DEBUG

/* Guest agent features, which meson.build checks regardless */
#define CONFIG_FSFREEZE
#define CONFIG_FSTRIM

/* Headers */
#define CONFIG_LINUX_MAGIC_H
#define HAVE_BTRFS_H
#define HAVE_OPENAT2_H
