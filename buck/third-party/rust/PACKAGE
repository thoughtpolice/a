load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# The prelude's names for the platforms reindeer configures crates for
# (reindeer.toml), and one of its own: Windows on arm64, which the
# prelude's take for Windows on x86_64, windows-msvc.
set_reindeer_platforms(select({
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
    "prelude//os:windows": select({
        "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
        "prelude//cpu:arm64": "windows-msvc-arm64",
    }),
}))
